<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.autogaussian.monitor</string>
  <key>ProgramArguments</key>
  <array><string>&lt;AG_EXECUTABLE&gt;</string><string>monitor</string><string>--watch</string><string>30</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>&lt;LOG_DIR&gt;/monitor.stdout.jsonl</string>
  <key>StandardErrorPath</key><string>&lt;LOG_DIR&gt;/monitor.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>&lt;SYSTEM_BIN_DIR&gt;:&lt;SYSTEM_SBIN_DIR&gt;</string></dict>
</dict>
</plist>
