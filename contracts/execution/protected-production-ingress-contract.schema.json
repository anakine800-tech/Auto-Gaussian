    "threatModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foreign_identical_module_rejected",
        "foreign_identical_class_rejected",
        "wrong_import_order_rejected",
        "pre_call_source_drift_rejected",
        "pre_call_cache_replacement_zero_claim",
        "post_check_arbitrary_same_process_mutation_prevented",
        "process_isolation_required_for_post_check_attacker"
      ],
      "properties": {
        "foreign_identical_module_rejected": {
