{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto-g16-nested-hop-identity-handshake-contract/1",
  "title": "Auto-G16 v2.6 nested-hop identity handshake request observation and receipt",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/observation"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$"},
    "nonce": {"type": "string", "pattern": "^[a-f0-9]{32,128}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "profile_sha256", "transport_identity_binding_sha256",
        "transport_config_bindings_sha256", "first_hop_receipt_sha256",
        "nested_hop_receipt_sha256", "request_nonce", "issued_at", "expires_at",
        "operation_version", "allowed_read_only_side_effects", "read_only",
        "single_attempt", "automatic_retry", "mutation_allowed"
      ],
      "properties": {
        "schema": {"const": "auto-g16-nested-hop-identity-handshake-request/1"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "transport_identity_binding_sha256": {"$ref": "#/$defs/sha256"},
        "transport_config_bindings_sha256": {"$ref": "#/$defs/sha256"},
        "first_hop_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "nested_hop_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "request_nonce": {"$ref": "#/$defs/nonce"},
        "issued_at": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"},
        "operation_version": {"const": "nested-hop-host-key-identity-handshake/1"},
        "allowed_read_only_side_effects": {"const": ["network_identity_handshake"]},
        "read_only": {"const": true},
        "single_attempt": {"const": true},
        "automatic_retry": {"const": false},
        "mutation_allowed": {"const": false}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "profile_sha256", "transport_identity_binding_sha256",
        "transport_config_bindings_sha256", "first_hop_receipt_sha256",
        "nested_hop_receipt_sha256", "second_hop_identity_sha256",
        "approved_host_key_evidence_sha256", "observed_fingerprint_evidence_sha256",
        "request_nonce", "issued_at", "expires_at", "operation_version",
        "classification", "read_only", "single_attempt", "automatic_retry",
        "mutation_allowed", "no_execution_authorization",
        "observation_payload_sha256"
      ],
      "properties": {
        "schema": {"const": "auto-g16-nested-hop-identity-handshake-observation/1"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "transport_identity_binding_sha256": {"$ref": "#/$defs/sha256"},
        "transport_config_bindings_sha256": {"$ref": "#/$defs/sha256"},
        "first_hop_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "nested_hop_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "second_hop_identity_sha256": {"$ref": "#/$defs/sha256"},
        "approved_host_key_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "observed_fingerprint_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "request_nonce": {"$ref": "#/$defs/nonce"},
        "issued_at": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"},
        "operation_version": {"const": "nested-hop-host-key-identity-handshake/1"},
        "classification": {"const": "observed"},
        "read_only": {"const": true},
        "single_attempt": {"const": true},
        "automatic_retry": {"const": false},
        "mutation_allowed": {"const": false},
        "no_execution_authorization": {"const": true},
        "observation_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "profile_sha256", "transport_identity_binding_sha256",
        "transport_config_bindings_sha256", "first_hop_receipt_sha256",
        "nested_hop_receipt_sha256", "second_hop_identity_sha256",
        "observed_fingerprint_evidence_sha256", "handshake_observation_sha256",
        "request_nonce", "issued_at", "expires_at", "operation_version",
        "classification", "read_only", "single_attempt", "automatic_retry",
        "mutation_allowed", "no_execution_authorization", "receipt_payload_sha256"
      ],
      "properties": {
        "schema": {"const": "auto-g16-nested-hop-identity-handshake-receipt/1"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "transport_identity_binding_sha256": {"$ref": "#/$defs/sha256"},
        "transport_config_bindings_sha256": {"$ref": "#/$defs/sha256"},
        "first_hop_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "nested_hop_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "second_hop_identity_sha256": {"$ref": "#/$defs/sha256"},
        "observed_fingerprint_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "handshake_observation_sha256": {"$ref": "#/$defs/sha256"},
        "request_nonce": {"$ref": "#/$defs/nonce"},
        "issued_at": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"},
        "operation_version": {"const": "nested-hop-host-key-identity-handshake/1"},
        "classification": {"const": "verified"},
        "read_only": {"const": true},
        "single_attempt": {"const": true},
        "automatic_retry": {"const": false},
        "mutation_allowed": {"const": false},
        "no_execution_authorization": {"const": true},
        "receipt_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
