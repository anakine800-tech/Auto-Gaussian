{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto-g16-protected-submit-bundle/1",
  "title": "Auto-G16 v2.6 owner-sealed protected submit bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "bundle_id",
    "identity",
    "workspace",
    "approvals",
    "execution",
    "resources",
    "transport",
    "stage",
    "operation_order",
    "authority",
    "failure_policy",
    "evidence_status",
    "bundle_payload_sha256"
  ],
  "properties": {
    "schema": {"const": "auto-g16-protected-submit-bundle/1"},
    "owner": {"const": "auto-g16-protected-submit-contract"},
    "bundle_id": {"type": "string", "pattern": "^protected-submit-[a-f0-9]{64}$"},
    "identity": {"$ref": "#/$defs/identity"},
    "workspace": {"$ref": "#/$defs/workspace"},
    "approvals": {"$ref": "#/$defs/approvals"},
    "execution": {"$ref": "#/$defs/execution"},
    "resources": {"$ref": "#/$defs/resources"},
    "transport": {"$ref": "#/$defs/transport"},
    "stage": {"$ref": "#/$defs/stage"},
    "operation_order": {
      "type": "array",
      "prefixItems": [
        {"const": "reserve_once"},
        {"const": "stage_exact_bundle"},
        {"const": "submit_once"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "authority": {"$ref": "#/$defs/authority"},
    "failure_policy": {"$ref": "#/$defs/failure"},
    "evidence_status": {"$ref": "#/$defs/evidence"},
    "bundle_payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "project": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$"},
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "scientific_task_id",
        "attempt_id",
        "input_sha256",
        "idempotency_key_sha256",
        "scientific_identity_sha256"
      ],
      "properties": {
        "project": {"$ref": "#/$defs/project"},
        "scientific_task_id": {
          "type": "string",
          "pattern": "^scientific-task-[a-f0-9]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^qsub-attempt-[a-f0-9]{64}$"
        },
        "input_sha256": {"$ref": "#/$defs/sha"},
        "idempotency_key_sha256": {"$ref": "#/$defs/sha"},
        "scientific_identity_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_root",
        "workspace_binding_sha256",
        "fresh_project_required",
        "no_overwrite",
        "no_symlink",
        "no_delete",
        "root_override_allowed"
      ],
      "properties": {
        "allowed_root": {"const": "/home/user100/SDL"},
        "workspace_binding_sha256": {"$ref": "#/$defs/sha"},
        "fresh_project_required": {"const": true},
        "no_overwrite": {"const": true},
        "no_symlink": {"const": true},
        "no_delete": {"const": true},
        "root_override_allowed": {"const": false}
      }
    },
    "inputApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_sha256", "payload_sha256"],
      "properties": {
        "schema": {
          "enum": [
            "gaussian-input-approval-receipt/1",
            "gaussian-input-approval-receipt/2",
            "gaussian-input-approval-receipt/3"
          ]
        },
        "artifact_sha256": {"$ref": "#/$defs/sha"},
        "payload_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "liveApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "approval_id",
        "artifact_sha256",
        "not_before",
        "expires_at"
      ],
      "properties": {
        "schema": {
          "enum": [
            "auto-g16-live-submission-approval/9",
            "auto-g16-live-submission-approval/10",
            "auto-g16-live-submission-approval/11"
          ]
        },
        "approval_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha"},
        "not_before": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_task_owner",
        "input_approval",
        "live_submission_approval"
      ],
      "properties": {
        "scientific_task_owner": {
          "const": "auto-g16-rtwin-pbs"
        },
        "input_approval": {"$ref": "#/$defs/inputApproval"},
        "live_submission_approval": {"$ref": "#/$defs/liveApproval"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_schema",
        "batch_id",
        "review_sha256",
        "ledger_sha256",
        "resource_state_revision",
        "resource_state_sha256"
      ],
      "properties": {
        "batch_schema": {"const": "gaussian-execution-batch/3"},
        "batch_id": {"type": "string", "minLength": 1},
        "review_sha256": {"$ref": "#/$defs/sha"},
        "ledger_sha256": {"$ref": "#/$defs/sha"},
        "resource_state_revision": {"type": "integer", "minimum": 0},
        "resource_state_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "gate_id",
        "gate_sha256",
        "resource_tier",
        "cores",
        "memory_gb",
        "walltime_seconds"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/sha"},
        "gate_id": {"type": "string", "minLength": 1},
        "gate_sha256": {"$ref": "#/$defs/sha"},
        "resource_tier": {
          "enum": ["simple", "general", "complex", "custom_reviewed"]
        },
        "cores": {"type": "integer", "minimum": 1},
        "memory_gb": {"type": "integer", "minimum": 1},
        "walltime_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "authorization_sha256",
        "successor_closure_sha256",
        "profile_sha256",
        "identity_binding_sha256",
        "transport_config_bindings_sha256",
        "handshake_receipt_sha256"
      ],
      "properties": {
        "authorization_id": {"$ref": "#/$defs/id"},
        "authorization_sha256": {"$ref": "#/$defs/sha"},
        "successor_closure_sha256": {"$ref": "#/$defs/sha"},
        "profile_sha256": {"$ref": "#/$defs/sha"},
        "identity_binding_sha256": {"$ref": "#/$defs/sha"},
        "transport_config_bindings_sha256": {"$ref": "#/$defs/sha"},
        "handshake_receipt_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema",
        "manifest_sha256",
        "bundle_sha256",
        "artifact_count",
        "artifact_order"
      ],
      "properties": {
        "manifest_schema": {"const": "auto-g16-immutable-stage-bundle/1"},
        "manifest_sha256": {"$ref": "#/$defs/sha"},
        "bundle_sha256": {"$ref": "#/$defs/sha"},
        "artifact_count": {"const": 2},
        "artifact_order": {
          "const": ["exact_gaussian_input", "fixed_scheduler_submission_binding"]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "submit",
        "status",
        "fetch",
        "cancel",
        "cleanup",
        "delete",
        "arbitrary_command"
      ],
      "properties": {
        "stage": {"const": true},
        "submit": {"const": true},
        "status": {"const": false},
        "fetch": {"const": false},
        "cancel": {"const": false},
        "cleanup": {"const": false},
        "delete": {"const": false},
        "arbitrary_command": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_nonce",
        "not_before",
        "expires_at",
        "single_use",
        "consumed",
        "automatic_retry",
        "scope"
      ],
      "properties": {
        "authority_nonce": {"$ref": "#/$defs/sha"},
        "not_before": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"},
        "single_use": {"const": true},
        "consumed": {"const": false},
        "automatic_retry": {"const": false},
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_reservation_state",
        "reconciliation",
        "automatic_retry",
        "automatic_cancel",
        "automatic_cleanup"
      ],
      "properties": {
        "post_reservation_state": {"const": "submission_uncertain"},
        "reconciliation": {"const": "existing_read_only_reconciliation_only"},
        "automatic_retry": {"const": false},
        "automatic_cancel": {"const": false},
        "automatic_cleanup": {"const": false}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_support",
        "offline_contract_validation",
        "actual_adapter_verified",
        "live_validation_performed",
        "external_actions_performed"
      ],
      "properties": {
        "code_support": {"const": true},
        "offline_contract_validation": {"const": true},
        "actual_adapter_verified": {"const": false},
        "live_validation_performed": {"const": false},
        "external_actions_performed": {"const": false}
      }
    }
  }
}
