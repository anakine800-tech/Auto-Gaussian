{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto-g16-execution-request/2",
  "title": "Auto-G16 v2.6 non-authorizing legacy transport execution request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "request_id", "historical_request", "profile", "project",
    "transport", "requested_operations", "intent_only", "proposal_only",
    "no_execution_authorization", "live_actions_performed", "request_payload_sha256"
  ],
  "properties": {
    "schema": {"const": "auto-g16-execution-request/2"},
    "request_id": {"$ref": "#/$defs/id"},
    "historical_request": {"$ref": "#/$defs/historical_request"},
    "profile": {"$ref": "#/$defs/profile"},
    "project": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$"},
    "transport": {"$ref": "#/$defs/transport"},
    "requested_operations": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/first_operation"},
        {"$ref": "#/$defs/nested_operation"},
        {"$ref": "#/$defs/handshake_operation"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "intent_only": {"const": true},
    "proposal_only": {"const": true},
    "no_execution_authorization": {"const": true},
    "live_actions_performed": {"const": false},
    "request_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "historical_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$"},
    "nonce": {"type": "string", "pattern": "^[a-f0-9]{32,128}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "historical_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "request_payload_sha256"],
      "properties": {
        "schema": {"const": "auto-g16-execution-request/1"},
        "request_id": {"$ref": "#/$defs/historical_id"},
        "request_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "profile_id", "profile_sha256", "backend_kind"],
      "properties": {
        "schema": {"const": "auto-g16-execution-profile/2"},
        "profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "backend_kind": {"const": "legacy_rtwin_pbs"}
      }
    },
    "first_config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hop_role", "adapter_config_ref", "adapter_config_ref_sha256"],
      "properties": {
        "hop_role": {"const": "first_hop"},
        "adapter_config_ref": {"const": "rtwin_ssh_config"},
        "adapter_config_ref_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "second_config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hop_role", "adapter_config_ref", "adapter_config_ref_sha256"],
      "properties": {
        "hop_role": {"const": "second_hop"},
        "adapter_config_ref": {"const": "windows_server_config"},
        "adapter_config_ref_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "config_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_owner", "first_hop", "second_hop", "bindings_payload_sha256"],
      "properties": {
        "adapter_owner": {"const": "auto-g16-rtwin-pbs"},
        "first_hop": {"$ref": "#/$defs/first_config_ref"},
        "second_hop": {"$ref": "#/$defs/second_config_ref"},
        "bindings_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_binding_sha256", "hop_count", "transport_config_bindings"],
      "properties": {
        "identity_binding_sha256": {"$ref": "#/$defs/sha256"},
        "hop_count": {"const": 2},
        "transport_config_bindings": {"$ref": "#/$defs/config_bindings"}
      }
    },
    "first_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operation_version", "request_nonce", "not_before", "expires_at", "allowed_read_only_side_effects", "read_only", "single_attempt", "automatic_retry", "mutation_allowed"],
      "properties": {
        "operation": {"const": "attest_first_hop_once"},
        "operation_version": {"const": "first-hop-identity-attestation/1"},
        "request_nonce": {"$ref": "#/$defs/nonce"},
        "not_before": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"},
        "allowed_read_only_side_effects": {"const": ["read_local_identity_sources", "network_identity_handshake"]},
        "read_only": {"const": true},
        "single_attempt": {"const": true},
        "automatic_retry": {"const": false},
        "mutation_allowed": {"const": false}
      }
    },
    "nested_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operation_version", "request_nonce", "not_before", "expires_at", "allowed_read_only_side_effects", "read_only", "single_attempt", "automatic_retry", "mutation_allowed"],
      "properties": {
        "operation": {"const": "attest_nested_hop_once"},
        "operation_version": {"const": "nested-hop-identity-attestation/1"},
        "request_nonce": {"$ref": "#/$defs/nonce"},
        "not_before": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"},
        "allowed_read_only_side_effects": {"const": ["read_remote_identity_source_hashes"]},
        "read_only": {"const": true},
        "single_attempt": {"const": true},
        "automatic_retry": {"const": false},
        "mutation_allowed": {"const": false}
      }
    },
    "handshake_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operation_version", "request_nonce", "not_before", "expires_at", "allowed_read_only_side_effects", "read_only", "single_attempt", "automatic_retry", "mutation_allowed"],
      "properties": {
        "operation": {"const": "handshake_nested_hop_identity_once"},
        "operation_version": {"const": "nested-hop-host-key-identity-handshake/1"},
        "request_nonce": {"$ref": "#/$defs/nonce"},
        "not_before": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"},
        "allowed_read_only_side_effects": {"const": ["network_identity_handshake"]},
        "read_only": {"const": true},
        "single_attempt": {"const": true},
        "automatic_retry": {"const": false},
        "mutation_allowed": {"const": false}
      }
    }
  }
}
